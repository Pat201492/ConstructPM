# ConstructPM Production Environment
# Copy to .env.production and fill in your values
# Run: ./deploy.sh secrets to auto-generate JWT secrets

# ── REQUIRED ──────────────────────────────────────────────
# Your domain (point DNS A record to this server's IP first)
DOMAIN=app.yourcompany.com

# Database
DB_NAME=construct_mgr
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# JWT secrets (run: ./deploy.sh secrets)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_DIFFERENT_ONE

# ── OPTIONAL ──────────────────────────────────────────────
DISPLAY_TOKEN=shopfloor

# AI: set to 'claude' if no GPU on server, 'auto' for Ollama+Claude fallback
AI_BACKEND=auto
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3:8b

# Claude API key (enables cloud AI fallback)
ANTHROPIC_API_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# OCR
OCR_BACKEND=tesseract
