{
  "cli": { "version": ">= 12.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "http://192.168.1.100:3000" }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://your-production-server.com" }
    },
    "production": {
      "ios": { "autoIncrement": true },
      "android": { "autoIncrement": true },
      "env": { "EXPO_PUBLIC_API_URL": "https://your-production-server.com" }
    }
  },
  "submit": {
    "production": {
      "ios": { "appleId": "your-apple-id@example.com", "ascAppId": "YOUR_APP_STORE_CONNECT_ID" },
      "android": { "serviceAccountKeyPath": "./google-play-key.json" }
    }
  }
}
