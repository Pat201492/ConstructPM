# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=construct_mgr
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_REFRESH_EXPIRES_IN=7d

# File Storage (S3 or MinIO)
STORAGE_TYPE=local
STORAGE_BASE_PATH=./storage

# Display Board (shop floor kiosk — no login needed)
DISPLAY_TOKEN=shopfloor

# Google Maps (auto-calculate miles from HQ to job sites)
# Get a key at: https://console.cloud.google.com/apis/credentials
# Enable: "Distance Matrix API" in your Google Cloud project
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# AI Services — Ollama (local, primary — free)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b
# OLLAMA_MODEL_COMPLEX=llama3:8b
# AI_BACKEND=auto        # 'ollama', 'claude', or 'auto' (tries ollama first)
# OCR_BACKEND=auto       # 'tesseract', 'textract', or 'auto' (tries tesseract first)

# AI Services — Cloud fallback (optional, paid)
# ANTHROPIC_API_KEY=your-claude-api-key
# AWS_TEXTRACT_REGION=us-east-1

# Email (SES or SendGrid)
# EMAIL_PROVIDER=ses
# SENDGRID_API_KEY=
# SES_REGION=us-east-1
# EMAIL_FROM=noreply@yourdomain.com

# Superadmin defaults to off — no user gets is_superadmin unless the
# email below is set. Migration 20260518_002 grants the flag (creating
# the user with ChangeMe123! if missing) when this is set.
# SUPERADMIN_BOOTSTRAP_EMAIL=you@yourdomain.com

# Firebase (Push Notifications)
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
