# Normalize line endings: repo stores LF; working tree gets platform default
* text=auto

# Binary files - never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary

# Linux Docker scripts must always be LF (even when checked out on Windows)
*.sh text eol=lf

# Windows-only scripts must always be CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
